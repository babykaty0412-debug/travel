{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trip",
  "type": "object",
  "required": [
    "meta",
    "dayColors",
    "dayEmoji",
    "map",
    "stays",
    "days",
    "food",
    "packing",
    "tipsHeading",
    "rainy",
    "drive",
    "wish",
    "footer"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["eyebrow", "heading", "sub", "chips", "trip"],
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string" },
        "heading": { "type": "string" },
        "sub": { "type": "string" },
        "chips": { "type": "array", "items": { "type": "string" } },
        "trip": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "dayColors": { "type": "object", "additionalProperties": { "type": "string" } },
    "dayEmoji": { "type": "object", "additionalProperties": { "type": "string" } },
    "map": {
      "type": "object",
      "required": ["hint", "legend", "places"],
      "additionalProperties": false,
      "properties": {
        "hint": { "type": "string" },
        "legend": { "type": "array", "items": { "type": "string" } },
        "places": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "desc", "query", "lat", "lng", "day"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "desc": { "type": "string" },
              "query": { "type": "string" },
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 },
              "day": { "type": "integer", "minimum": 1 },
              "hotel": { "type": "boolean" }
            }
          }
        }
      }
    },
    "stays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["night", "name", "addr", "feat", "query"],
        "additionalProperties": false,
        "properties": {
          "night": { "type": "string" },
          "name": { "type": "string" },
          "addr": { "type": "string" },
          "feat": { "type": "string" },
          "query": { "type": "string" },
          "tel": { "type": "string" }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tag", "color", "date", "title", "stops"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "tag": { "type": "string" },
          "color": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "stops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["time", "title"],
              "additionalProperties": false,
              "properties": {
                "time": { "type": "string" },
                "title": { "type": "string" },
                "color": { "type": "string" },
                "badge": { "type": "string" },
                "highlight": { "type": "boolean" },
                "opt": { "type": "boolean" },
                "drive": { "type": "string" },
                "bullets": { "type": "array", "items": { "type": "string" } },
                "query": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "food": {
      "type": "object",
      "required": ["cards", "note"],
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "green", "items"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "green": { "type": "boolean" },
              "items": { "type": "array", "items": { "type": "string" } },
              "navs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "query"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string" },
                    "query": { "type": "string" }
                  }
                }
              },
              "note": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "packing": { "type": "array", "items": { "type": "string" } },
    "tipsHeading": { "type": "string" },
    "rainy": {
      "type": "object",
      "required": ["title", "items"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "items": { "$ref": "#/$defs/tipItems" }
      }
    },
    "drive": {
      "type": "object",
      "required": ["title", "items", "table"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "items": { "$ref": "#/$defs/tipItems" },
        "table": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "wish": {
      "type": "object",
      "required": ["intro", "placeholder", "whoPlaceholder", "button", "suggestHint", "suggests", "pool"],
      "additionalProperties": false,
      "properties": {
        "intro": { "type": "string" },
        "placeholder": { "type": "string" },
        "whoPlaceholder": { "type": "string" },
        "button": { "type": "string" },
        "suggestHint": { "type": "string" },
        "suggests": { "type": "array", "items": { "type": "string" } },
        "pool": { "type": "array", "items": { "type": "string" } }
      }
    },
    "footer": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "tipItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ic", "html"],
        "additionalProperties": false,
        "properties": {
          "ic": { "type": "string" },
          "html": { "type": "string" }
        }
      }
    }
  }
}
